{
    "name": "supertext/grav-supertext-translation",
    "description": "Supertext AI translation for Grav CMS pages",
    "type": "grav-plugin",
    "license": "MIT",
    "homepage": "https://github.com/Supertext/Grav-Supertext-Translation",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\SupertextTranslation\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grav\\Plugin\\SupertextTranslation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "docs:screenshots": "sh scripts/docs-screenshots.sh"
    },
    "config": {
        "sort-packages": true
    }
}
