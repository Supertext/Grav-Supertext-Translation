# Variables for the Grav demo (set them in Railway → service → Variables, never in the repo).

# Supertext API key (with or without the "Supertext-Auth-Key " prefix).
# No account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=

# Version reports to the Supertext Commando Center (site URL, plugin/Grav/PHP versions, API key
# check result; never content, the key or personal data). On unless set to 0. It overrides the
# "Send version information to Supertext" setting.
SUPERTEXT_VERSION_REPORTS=

# Created on every start if they don't exist yet; existing accounts are never changed.
# Passwords need 8+ characters with a number, an upper- and a lower-case letter (Grav's rule).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Set by Railway.
PORT=8080
