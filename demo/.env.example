# Variables for the Grav demo (set them in Railway → service → Variables, never in the repo).

# Supertext API key (with or without the "Supertext-Auth-Key " prefix).
SUPERTEXT_API_KEY=

# Created on every start if they don't exist yet; existing accounts are never changed.
# Passwords need 8+ characters with a number, an upper- and a lower-case letter (Grav's rule).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Set by Railway.
PORT=8080
